# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Anthropic API Key（必填，主调用）
ANTHROPIC_API_KEY=sk-ant-xxx

# 用于签发和验证 JWT（演示用任意字符串，生产换成强随机值）
JWT_SECRET=dev-jwt-secret-change-me

# ─── 数据库 ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://agentflow:agentflow_dev_password@localhost:5432/agentflow

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API 服务 ─────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# 演示租户（init.sql 已建好的电商租户 A）
DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001
DEMO_TENANT_SLUG=tenant-ecommerce
