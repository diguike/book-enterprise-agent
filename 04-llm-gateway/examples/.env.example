# Anthropic API Key（必填，用于主力模型）
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI API Key（可选，用于 Fallback 路由）
OPENAI_API_KEY=sk-xxx

# Redis 连接（需要 Redis Stack，支持向量搜索）
# 本地开发：docker run -d -p 6379:6379 redis/redis-stack:latest
REDIS_URL=redis://localhost:6379

# PostgreSQL 连接（用于审计日志）
# 本地开发：docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentflow

# 日志级别（debug | info | warn | error）
LOG_LEVEL=info
