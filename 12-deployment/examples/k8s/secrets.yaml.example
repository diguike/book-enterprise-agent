# Secret 模板（不要直接 commit 真实凭证）
# 生产环境用 Sealed Secrets / External Secrets Operator / SOPS 管理
# 部署前先 cp secrets.yaml.example secrets.yaml 并填入真实值

---
# 数据库连接串
apiVersion: v1
kind: Secret
metadata:
  name: agentflow-secrets
  namespace: agentflow
type: Opaque
stringData:
  # 通过 PgBouncer 连接，端口 6432 而不是 5432
  database-url: 'postgresql://agentflow:CHANGEME@pgbouncer.agentflow.svc.cluster.local:6432/agentflow?sslmode=require'
  # Redis Cluster 入口（任一节点）
  redis-url: 'redis://redis-cluster-0.redis-cluster.agentflow.svc.cluster.local:6379'
  # JWT 签名密钥（最少 32 字节随机字符串）
  jwt-secret: 'CHANGE_THIS_TO_A_LONG_RANDOM_STRING'
  # 第 9 章的 audit log HMAC key
  audit-hmac-key: 'CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_STRING'

---
# LLM 提供商 API Keys
apiVersion: v1
kind: Secret
metadata:
  name: llm-keys
  namespace: agentflow
type: Opaque
stringData:
  anthropic: 'sk-ant-CHANGEME'
  openai: 'sk-CHANGEME'
  # 备用提供商
  bedrock-access-key: 'CHANGEME'
  bedrock-secret-key: 'CHANGEME'

---
# Postgres 管理员密码（仅 StatefulSet 演示用）
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secrets
  namespace: agentflow
type: Opaque
stringData:
  username: 'agentflow'
  password: 'CHANGEME'

---
# 私有镜像仓库凭证
# 生成方式：
#   kubectl create secret docker-registry regcred \
#     --docker-server=<your-registry> \
#     --docker-username=<user> \
#     --docker-password=<pass> \
#     --docker-email=<email> \
#     -n agentflow --dry-run=client -o yaml
apiVersion: v1
kind: Secret
metadata:
  name: regcred
  namespace: agentflow
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: BASE64_ENCODED_DOCKER_CONFIG_JSON
